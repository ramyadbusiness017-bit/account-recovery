# ==========================================
# Gonnit Account Recovery & Identity Config
# ==========================================

PROJECT_NAME=Gonnit
SECRET_KEY=gonnit-super-secret-key-recovery-system-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CHALLENGE_TIMEOUT_SECONDS=600
DATABASE_URL=sqlite:///./gonnit.db

# Live SMTP Configuration (Optional)
# If SMTP_ENABLED=False, emails are stored in database and previewable in the Live Security Mailbox
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=security@gonnit.com
SMTP_FROM_NAME="Gonnit Account Security"

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
